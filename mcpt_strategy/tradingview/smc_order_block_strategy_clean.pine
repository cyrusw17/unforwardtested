//@version=5
strategy("SMC Order Block + Structure", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_order, commission_value=13, slippage=3)

ob_lookback = input.int(5, "Order Block Lookback", minval=2, maxval=20)
structure_length = input.int(5, "Structure Swing Length", minval=2, maxval=20)
atr_period = input.int(14, "ATR Period", minval=5, maxval=50)
atr_sl_mult = input.float(1.0, "ATR Stop Loss Multiplier", minval=0.5, maxval=3.0, step=0.1)
atr_tp_mult = input.float(3.0, "ATR Take Profit Multiplier", minval=1.0, maxval=5.0, step=0.5)
use_structure_filter = input.bool(true, "Use Structure Filter")
risk_percent = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1)

show_order_blocks = input.bool(true, "Show Order Blocks", group="Visuals")
show_structure = input.bool(true, "Show Market Structure", group="Visuals")
bullish_ob_color = input.color(color.new(color.green, 80), "Bullish OB Color", group="Visuals")
bearish_ob_color = input.color(color.new(color.red, 80), "Bearish OB Color", group="Visuals")

body = math.abs(close - open)
avg_body = ta.sma(body, 20)

strong_bullish = close > open and body > avg_body * 1.5
strong_bearish = close < open and body > avg_body * 1.5

var bool bullish_ob = false
var bool bearish_ob = false
var float bullish_ob_high = na
var float bullish_ob_low = na
var float bearish_ob_high = na
var float bearish_ob_low = na
var int bullish_ob_bar = na
var int bearish_ob_bar = na

if strong_bullish
    for i = 1 to ob_lookback
        if i < bar_index and close[i] < open[i]
            bullish_ob := true
            bullish_ob_high := high[i]
            bullish_ob_low := low[i]
            bullish_ob_bar := bar_index - i
            break

if strong_bearish
    for i = 1 to ob_lookback
        if i < bar_index and close[i] > open[i]
            bearish_ob := true
            bearish_ob_high := high[i]
            bearish_ob_low := low[i]
            bearish_ob_bar := bar_index - i
            break

if bullish_ob and (bar_index - bullish_ob_bar) > 50
    bullish_ob := false
if bearish_ob and (bar_index - bearish_ob_bar) > 50
    bearish_ob := false

at_bullish_ob = bullish_ob and low <= bullish_ob_high and low >= bullish_ob_low
at_bearish_ob = bearish_ob and high >= bearish_ob_low and high <= bearish_ob_high

recent_high = ta.highest(high, structure_length)
recent_low = ta.lowest(low, structure_length)

var int structure = 0

if close > recent_high[1]
    structure := 1

if close < recent_low[1]
    structure := -1

long_signal = at_bullish_ob and (not use_structure_filter or structure >= 0)
short_signal = at_bearish_ob and (not use_structure_filter or structure <= 0)

atr = ta.atr(atr_period)

calculate_position_size(entry_price, stop_loss) =>
    risk_amount = strategy.equity * (risk_percent / 100)
    stop_distance = math.abs(entry_price - stop_loss)
    position_size = risk_amount / (stop_distance * 100000)
    max_position = strategy.equity * 50 / (100000 * entry_price)
    math.min(position_size, max_position)

if long_signal and strategy.position_size == 0
    stop_loss = close - (atr * atr_sl_mult)
    take_profit = close + (atr * atr_tp_mult)
    pos_size = calculate_position_size(close, stop_loss)
    strategy.entry("Long", strategy.long, qty=pos_size)
    strategy.exit("Long Exit", "Long", stop=stop_loss, limit=take_profit)
    label.new(bar_index, low, "LONG\nSL:" + str.tostring(stop_loss, "#.####") + "\nTP:" + str.tostring(take_profit, "#.####"), 
        style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if short_signal and strategy.position_size == 0
    stop_loss = close + (atr * atr_sl_mult)
    take_profit = close - (atr * atr_tp_mult)
    pos_size = calculate_position_size(close, stop_loss)
    strategy.entry("Short", strategy.short, qty=pos_size)
    strategy.exit("Short Exit", "Short", stop=stop_loss, limit=take_profit)
    label.new(bar_index, high, "SHORT\nSL:" + str.tostring(stop_loss, "#.####") + "\nTP:" + str.tostring(take_profit, "#.####"), 
        style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

if show_order_blocks
    if bullish_ob and not na(bullish_ob_high)
        line.new(bullish_ob_bar, bullish_ob_high, bar_index, bullish_ob_high, 
            color=bullish_ob_color, width=1, style=line.style_dashed)
        line.new(bullish_ob_bar, bullish_ob_low, bar_index, bullish_ob_low, 
            color=bullish_ob_color, width=1, style=line.style_dashed)
        box.new(bullish_ob_bar, bullish_ob_high, bar_index, bullish_ob_low, 
            border_color=color.new(color.green, 70), bgcolor=bullish_ob_color)
    
    if bearish_ob and not na(bearish_ob_high)
        line.new(bearish_ob_bar, bearish_ob_high, bar_index, bearish_ob_high, 
            color=bearish_ob_color, width=1, style=line.style_dashed)
        line.new(bearish_ob_bar, bearish_ob_low, bar_index, bearish_ob_low, 
            color=bearish_ob_color, width=1, style=line.style_dashed)
        box.new(bearish_ob_bar, bearish_ob_high, bar_index, bearish_ob_low, 
            border_color=color.new(color.red, 70), bgcolor=bearish_ob_color)

if show_structure
    bgcolor(structure == 1 ? color.new(color.green, 95) : 
            structure == -1 ? color.new(color.red, 95) : na)

plot(structure == 1 ? 1 : structure == -1 ? -1 : 0, "Structure", 
    color=structure == 1 ? color.green : structure == -1 ? color.red : color.gray, 
    style=plot.style_histogram, linewidth=1, display=display.data_window)

plot(atr, "ATR", color=color.blue, display=display.data_window)
plot(strategy.position_size, "Position Size", color=color.orange, display=display.data_window)
plot(strategy.equity, "Equity", color=color.purple, display=display.data_window)

alertcondition(long_signal, title="Long Entry Signal", 
    message="SMC Strategy: LONG signal on {{ticker}} at {{close}}")
alertcondition(short_signal, title="Short Entry Signal", 
    message="SMC Strategy: SHORT signal on {{ticker}} at {{close}}")
